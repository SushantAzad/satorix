POSTGRES_USER=satorix
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
API_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
DEFAULT_ADMIN_EMAIL=admin@example.invalid
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
