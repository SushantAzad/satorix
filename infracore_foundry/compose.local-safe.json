{
  "name": "satorix-local-safe",
  "services": {
    "postgres": {
      "image": "pgvector/pgvector:pg15",
      "environment": {
        "POSTGRES_DB": "satorix_safe",
        "POSTGRES_USER": "satorix_safe",
        "POSTGRES_PASSWORD": "LocalFixturePasswordOnly123"
      },
      "ports": [
        "127.0.0.1:5432:5432"
      ],
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U satorix_safe -d satorix_safe"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "minio": {
      "image": "minio/minio:latest",
      "environment": {
        "MINIO_ROOT_USER": "localfixture",
        "MINIO_ROOT_PASSWORD": "LocalFixtureMinioOnly123",
        "MINIO_UPDATE": "off"
      },
      "ports": [
        "127.0.0.1:9000:9000",
        "127.0.0.1:9001:9001"
      ],
      "volumes": [
        "minio_data:/data"
      ],
      "command": "server /data --console-address \":9001\"",
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:9000/minio/health/live"
        ],
        "interval": "30s",
        "timeout": "20s",
        "retries": 3
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "minio-init": {
      "image": "minio/mc",
      "environment": {
        "MINIO_ACCESS_KEY": "localfixture",
        "MINIO_SECRET_KEY": "LocalFixtureMinioOnly123",
        "MINIO_UPDATE": "off"
      },
      "entrypoint": [
        "/bin/sh",
        "-ec",
        "mc alias set fixture http://minio:9000 localfixture LocalFixtureMinioOnly123; mc mb --ignore-existing fixture/raw-data fixture/processed-data fixture/profiling-reports fixture/model-artifacts"
      ],
      "pull_policy": "never",
      "restart": "no",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "redis": {
      "image": "redis:7-alpine",
      "ports": [
        "127.0.0.1:6379:6379"
      ],
      "volumes": [
        "redis_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "environment": {}
    },
    "kafka": {
      "image": "apache/kafka:3.7.0",
      "ports": [
        "127.0.0.1:9092:9092",
        "127.0.0.1:9094:9094"
      ],
      "environment": {
        "KAFKA_NODE_ID": "1",
        "KAFKA_PROCESS_ROLES": "controller,broker",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093,PLAINTEXT_HOST://:9094",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9094",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka:9093",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_AUTO_CREATE_TOPICS_ENABLE": "true",
        "KAFKA_LOG_RETENTION_HOURS": "168",
        "KAFKA_LOG_SEGMENT_BYTES": "1073741824",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS": "0"
      },
      "volumes": [
        "kafka_data:/var/lib/kafka/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list || exit 1"
        ],
        "interval": "30s",
        "timeout": "15s",
        "retries": 5,
        "start_period": "30s"
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "neo4j": {
      "image": "neo4j:5.14",
      "hostname": "neo4j",
      "ports": [
        "127.0.0.1:7474:7474",
        "127.0.0.1:7687:7687"
      ],
      "environment": {
        "NEO4J_AUTH": "neo4j/LocalFixtureNeo4jOnly123",
        "NEO4J_PLUGINS": "[]",
        "NEO4J_dbms_memory_heap_initial__size": "2G",
        "NEO4J_dbms_memory_heap_max__size": "4G"
      },
      "volumes": [
        "neo4j_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "cypher-shell -u neo4j -p LocalFixtureNeo4jOnly123 'RETURN 1' || exit 1"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 5,
        "start_period": "60s"
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "elasticsearch": {
      "image": "elasticsearch:8.11.0",
      "environment": {
        "discovery.type": "single-node",
        "xpack.security.enabled": "false",
        "ES_JAVA_OPTS": "-Xms1g -Xmx2g",
        "ingest.geoip.downloader.enabled": "false"
      },
      "ports": [
        "127.0.0.1:9200:9200"
      ],
      "volumes": [
        "elasticsearch_data:/usr/share/elasticsearch/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:9200/_cluster/health"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 5,
        "start_period": "60s"
      },
      "restart": "no",
      "pull_policy": "never",
      "networks": [
        "local-safe"
      ],
      "dns": [
        "127.0.0.1"
      ],
      "cap_drop": [
        "NET_RAW"
      ],
      "security_opt": [
        "no-new-privileges:true"
