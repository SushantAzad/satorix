POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infracore
POSTGRES_USER=infracore
POSTGRES_PASSWORD=infracore_dev_password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=infracore_minio
MINIO_SECRET_KEY=infracore_minio_secret
MINIO_RAW_BUCKET=raw-data
MINIO_SECURE=false

REDIS_URL=redis://localhost:6379/0

ENCRYPTION_KEY=Fn19nEJDDbov3wCmSP2sSc7VOV2JIAY5HasMlMMTEQo=

SANDBOX_API_KEY=your-sandbox-co-in-api-key-here

GOOGLE_CREDENTIALS_PATH=./credentials/google_service_account.json

API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO

# API authentication — generate a strong key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty ONLY for local development (auth is bypassed with a warning).
API_KEY=

# Layer 3 — Ontology Layer
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=infracore123
ELASTICSEARCH_URL=http://localhost:9200
LAYER3_API_PORT=8003
SCHEMA_VERSION=1.0.0
RISK_SCORE_BATCH_SIZE=100
INGEST_CHUNK_SIZE=1000

# Layer 4 — Graph Intelligence
LAYER4_API_PORT=8004
NEO4J_MAX_POOL_SIZE=10

# ── LLM Provider Configuration ─────────────────────────────────────────────
# Set to "anthropic" for production or "ollama" for local dev / offline use
LLM_PROVIDER=ollama

# Anthropic (production)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local dev / offline / on-premise)
# Change OLLAMA_MODEL based on your RAM:
#   4-8GB RAM:   phi4-mini:3.8b
#   8-16GB RAM:  qwen3:8b       ← default, recommended
#   16-32GB RAM: qwen3:14b
#   32GB+ RAM:   qwen3:30b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300

# Layer 6 — Application / Dashboards
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

DEFAULT_ADMIN_EMAIL=admin@satorix.internal
DEFAULT_ADMIN_PASSWORD=SatorixAdmin2026!

LAYER6_API_PORT=8006

# Kafka (shared across layers)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Layer 5 — Analytics & AI
LAYER5_API_PORT=8005

# RAG / Vector search
# pgvector is enabled on the shared PostgreSQL instance (pgvector/pgvector:pg15 image)
# No additional service needed — embeddings stored in l5_document_embeddings table
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Layer URLs (used by inter-service calls within Docker; use service names not localhost)
LAYER1_API_URL=http://layer1:8001
LAYER3_API_URL=http://layer3:8003
LAYER4_API_URL=http://layer4:8004
LAYER5_API_URL=http://layer5:8005
